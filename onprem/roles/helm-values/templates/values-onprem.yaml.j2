# =============================================================================
# values-onprem.yaml — On-premises Helm override values for {{ service_name }}
# Generated by Ansible helm-values role. Do not edit manually.
# Requirements: 3.1, 3.2, 3.3, 3.4, 3.5
# =============================================================================

image:
  repository: "{{ registry_ip }}:{{ registry_port }}/retail-store-{{ service_name }}"
  pullPolicy: IfNotPresent
  tag: "{{ git_sha }}"

# Remove ECR pull secret — local registry requires no authentication (Req 3.2)
imagePullSecrets: []

{% if service_name == 'cart' %}
# Cart: use in-memory persistence — no DynamoDB required on-prem (Req 3.3)
app:
  persistence:
    provider: in-memory

{% elif service_name == 'orders' %}
# Orders: use in-memory persistence and messaging — no PostgreSQL/RabbitMQ required (Req 3.4)
app:
  persistence:
    provider: in-memory
  messaging:
    provider: in-memory

# Disable AWS security group controller annotations (Req 3.5)
securityGroups:
  create: false

{% elif service_name == 'catalog' %}
# Catalog: disable AWS security group controller annotations (Req 3.5)
securityGroups:
  create: false

{% elif service_name == 'ui' %}
# UI: enable NGINX Ingress with local hostname, no TLS/cert-manager (Req 3.1, 4.3, 4.4)
ingress:
  enabled: true
  className: nginx
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
  hosts:
    - host: "{{ retail_store_hostname }}"
      paths:
        - path: /
          pathType: Prefix
  tls: []

# Disable all cert-manager / Let's Encrypt configuration
certManager:
  createClusterIssuer: false

# Disable the multi-ingress entries that reference cloud-issued certs
ingresses: []

{% endif %}
